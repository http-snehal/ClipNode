<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard — ClipNode</title>
    <meta name="description" content="ClipNode admin panel — manage users and pastes.">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #1e1e1e; }
        ::-webkit-scrollbar-thumb { background: #3c3c3c; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #555; }
        .stat-card { background: #252526; border: 1px solid #333; transition: border-color 0.2s, transform 0.2s; }
        .stat-card:hover { border-color: #3b82f6; transform: translateY(-2px); }
        .data-table th { background: #2d2d2d; }
        .data-table tr { border-bottom: 1px solid #2a2a2a; transition: background 0.15s; }
        .data-table tbody tr:hover { background: #252526; }
        .badge { font-family: 'Fira Code', monospace; }
        .tab-btn { transition: all 0.2s ease; }
        .tab-btn.active { background: #1e1e1e; border-bottom: 2px solid #3b82f6; color: #fff; }
        .tab-panel { animation: fadeIn 0.25s ease; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
        .delete-btn { transition: all 0.15s ease; }
        .delete-btn:hover { background: #dc2626; color: #fff; border-color: #dc2626; }
        .toast { transition: all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55); }
    </style>
</head>
<body class="bg-[#1e1e1e] text-gray-200 min-h-screen flex flex-col">

    <!-- Header -->
    <header class="h-16 bg-[#252526] border-b border-[#333] flex items-center justify-between px-6 shadow-md z-10 flex-shrink-0">
        <a href="/" class="text-xl font-bold tracking-tight text-white flex items-center gap-2 hover:opacity-90 transition-opacity">
            <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center shadow-lg shadow-blue-500/20">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                </svg>
            </div>
            <span>Clip<span class="text-blue-500">Node</span></span>
        </a>

        <div class="flex items-center gap-3">
            <span class="hidden sm:flex items-center gap-2 bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-semibold px-3 py-1.5 rounded-lg">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                Admin Panel
            </span>
            <span class="text-sm text-gray-300 font-medium"><%= currentUser.username %></span>
            <a href="/" class="bg-[#1e1e1e] hover:bg-[#333] border border-[#3c3c3c] text-xs text-gray-300 px-3 py-1.5 rounded-lg transition-colors">
                ← Editor
            </a>
            <form action="/logout" method="POST" style="display:inline">
                <button type="submit" class="bg-red-600/20 hover:bg-red-600 border border-red-600/40 hover:border-red-600 text-red-400 hover:text-white text-xs font-medium px-3 py-1.5 rounded-lg transition-all">
                    Logout
                </button>
            </form>
        </div>
    </header>

    <!-- Flash messages -->
    <% if (flashSuccess && flashSuccess.length > 0) { %>
        <div id="flash-success" class="mx-6 mt-4 flex items-center gap-3 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-sm px-4 py-3 rounded-lg">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span><%= flashSuccess[0] %></span>
        </div>
    <% } %>
    <% if (flashError && flashError.length > 0) { %>
        <div id="flash-error" class="mx-6 mt-4 flex items-center gap-3 bg-red-500/10 border border-red-500/30 text-red-400 text-sm px-4 py-3 rounded-lg">
            <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span><%= flashError[0] %></span>
        </div>
    <% } %>

    <!-- Main Content -->
    <main class="flex-1 overflow-y-auto px-6 py-6">

        <!-- Page Title -->
        <div class="mb-6">
            <h1 class="text-2xl font-bold text-white">Admin Dashboard</h1>
            <p class="text-sm text-gray-400 mt-1">Manage users and pastes across ClipNode</p>
        </div>

        <!-- Stats Row -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
            <!-- Total Users -->
            <div class="stat-card rounded-xl p-5 flex items-center gap-4">
                <div class="w-12 h-12 bg-blue-600/15 border border-blue-500/30 rounded-xl flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                </div>
                <div>
                    <p class="text-3xl font-bold text-white"><%= stats.totalUsers %></p>
                    <p class="text-xs text-gray-400 mt-0.5">Total Users</p>
                </div>
            </div>
            <!-- Total Pastes -->
            <div class="stat-card rounded-xl p-5 flex items-center gap-4">
                <div class="w-12 h-12 bg-purple-600/15 border border-purple-500/30 rounded-xl flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                </div>
                <div>
                    <p class="text-3xl font-bold text-white"><%= stats.totalPastes %></p>
                    <p class="text-xs text-gray-400 mt-0.5">Total Pastes</p>
                </div>
            </div>
            <!-- Active Pastes -->
            <div class="stat-card rounded-xl p-5 flex items-center gap-4">
                <div class="w-12 h-12 bg-emerald-600/15 border border-emerald-500/30 rounded-xl flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <div>
                    <p class="text-3xl font-bold text-white"><%= stats.activePastes %></p>
                    <p class="text-xs text-gray-400 mt-0.5">Active Pastes</p>
                </div>
            </div>
        </div>

        <!-- Tabs -->
        <div class="flex gap-1 border-b border-[#333] mb-6">
            <button id="tab-users-btn" onclick="showTab('users')" class="tab-btn active text-sm font-medium px-5 py-2.5 rounded-t-lg text-gray-300">
                👥 Users (<%= stats.totalUsers %>)
            </button>
            <button id="tab-pastes-btn" onclick="showTab('pastes')" class="tab-btn text-sm font-medium px-5 py-2.5 rounded-t-lg text-gray-400 hover:text-gray-200">
                📋 Pastes (<%= stats.totalPastes %>)
            </button>
        </div>

        <!-- Users Tab -->
        <div id="tab-users" class="tab-panel">
            <div class="bg-[#252526] border border-[#333] rounded-xl overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="data-table w-full text-sm">
                        <thead>
                            <tr class="text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">
                                <th class="px-5 py-3">Username</th>
                                <th class="px-5 py-3">Email</th>
                                <th class="px-5 py-3">Role</th>
                                <th class="px-5 py-3">Pastes</th>
                                <th class="px-5 py-3">Joined</th>
                                <th class="px-5 py-3 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (users.length === 0) { %>
                                <tr>
                                    <td colspan="6" class="px-5 py-10 text-center text-gray-500">No users registered yet.</td>
                                </tr>
                            <% } %>
                            <% users.forEach(user => { %>
                                <tr>
                                    <td class="px-5 py-3.5">
                                        <div class="flex items-center gap-2.5">
                                            <div class="w-8 h-8 rounded-lg bg-blue-600/20 border border-blue-500/20 flex items-center justify-center text-blue-400 font-bold text-sm flex-shrink-0">
                                                <%= user.username.charAt(0).toUpperCase() %>
                                            </div>
                                            <span class="font-medium text-gray-200 font-mono"><%= user.username %></span>
                                        </div>
                                    </td>
                                    <td class="px-5 py-3.5 text-gray-400 font-mono text-xs"><%= user.email %></td>
                                    <td class="px-5 py-3.5">
                                        <% if (user.role === 'admin') { %>
                                            <span class="badge inline-flex items-center gap-1.5 bg-amber-500/15 border border-amber-500/30 text-amber-400 text-xs font-semibold px-2.5 py-1 rounded-full">
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                                                admin
                                            </span>
                                        <% } else { %>
                                            <span class="badge inline-flex items-center gap-1.5 bg-gray-500/15 border border-gray-500/30 text-gray-400 text-xs font-semibold px-2.5 py-1 rounded-full">
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                                                user
                                            </span>
                                        <% } %>
                                    </td>
                                    <td class="px-5 py-3.5">
                                        <span class="badge text-xs text-gray-300 bg-[#1e1e1e] border border-[#3c3c3c] px-2 py-1 rounded">
                                            <%= pasteCountMap[user._id.toString()] || 0 %>
                                        </span>
                                    </td>
                                    <td class="px-5 py-3.5 text-xs text-gray-500 font-mono">
                                        <%= new Date(user.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                                    </td>
                                    <td class="px-5 py-3.5 text-right">
                                        <% if (user._id.toString() !== currentUser.id.toString()) { %>
                                            <form action="/admin/delete-user/<%= user._id %>" method="POST" onsubmit="return confirmDelete('user', '<%= user.username %>')">
                                                <button type="submit" class="delete-btn bg-[#1e1e1e] border border-[#3c3c3c] text-red-400 text-xs font-medium px-3 py-1.5 rounded-lg">
                                                    Delete
                                                </button>
                                            </form>
                                        <% } else { %>
                                            <span class="text-xs text-gray-600 italic">You</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Pastes Tab -->
        <div id="tab-pastes" class="tab-panel hidden">
            <div class="bg-[#252526] border border-[#333] rounded-xl overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="data-table w-full text-sm">
                        <thead>
                            <tr class="text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">
                                <th class="px-5 py-3">Short ID</th>
                                <th class="px-5 py-3">Language</th>
                                <th class="px-5 py-3">Created By</th>
                                <th class="px-5 py-3">Created At</th>
                                <th class="px-5 py-3">Expires</th>
                                <th class="px-5 py-3 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (pastes.length === 0) { %>
                                <tr>
                                    <td colspan="6" class="px-5 py-10 text-center text-gray-500">No pastes created yet.</td>
                                </tr>
                            <% } %>
                            <% pastes.forEach(paste => { %>
                                <tr>
                                    <td class="px-5 py-3.5">
                                        <a href="/<%= paste.shortId %>" target="_blank" class="badge text-blue-400 hover:text-blue-300 font-mono text-xs bg-blue-600/10 border border-blue-500/20 px-2.5 py-1 rounded hover:bg-blue-600/20 transition-colors">
                                            <%= paste.shortId %>
                                            <svg class="w-3 h-3 inline ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                                        </a>
                                    </td>
                                    <td class="px-5 py-3.5">
                                        <span class="badge text-xs text-gray-300 bg-[#1e1e1e] border border-[#3c3c3c] px-2 py-1 rounded font-mono">
                                            <%= paste.language || 'plaintext' %>
                                        </span>
                                    </td>
                                    <td class="px-5 py-3.5 text-xs font-mono">
                                        <% if (paste.userId) { %>
                                            <span class="text-gray-300"><%= paste.userId.username %></span>
                                        <% } else { %>
                                            <span class="text-gray-600 italic">Anonymous</span>
                                        <% } %>
                                    </td>
                                    <td class="px-5 py-3.5 text-xs text-gray-500 font-mono">
                                        <%= new Date(paste.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                                    </td>
                                    <td class="px-5 py-3.5 text-xs font-mono">
                                        <% if (paste.expiresAt) { %>
                                            <% const isExpired = new Date(paste.expiresAt) < new Date(); %>
                                            <span class="<%= isExpired ? 'text-red-400' : 'text-gray-400' %>">
                                                <%= isExpired ? '⚠ Expired' : new Date(paste.expiresAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                                            </span>
                                        <% } else { %>
                                            <span class="text-emerald-400 font-semibold">Never</span>
                                        <% } %>
                                    </td>
                                    <td class="px-5 py-3.5 text-right">
                                        <form action="/admin/delete-paste/<%= paste._id %>" method="POST" onsubmit="return confirmDelete('paste', '<%= paste.shortId %>')">
                                            <button type="submit" class="delete-btn bg-[#1e1e1e] border border-[#3c3c3c] text-red-400 text-xs font-medium px-3 py-1.5 rounded-lg">
                                                Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </main>

    <!-- Toast Container -->
    <div id="toast-container" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2"></div>

    <script>
        function showTab(tab) {
            document.getElementById('tab-users').classList.add('hidden');
            document.getElementById('tab-pastes').classList.add('hidden');
            document.getElementById('tab-users-btn').classList.remove('active');
            document.getElementById('tab-pastes-btn').classList.remove('active');

            document.getElementById('tab-' + tab).classList.remove('hidden');
            document.getElementById('tab-' + tab + '-btn').classList.add('active');
        }

        function confirmDelete(type, identifier) {
            return confirm(`Are you sure you want to delete this ${type}: "${identifier}"?\nThis action cannot be undone.`);
        }

        // Auto-dismiss flash messages
        setTimeout(() => {
            ['flash-success', 'flash-error'].forEach(id => {
                const el = document.getElementById(id);
                if (el) { el.style.opacity = '0'; el.style.transition = 'opacity 0.5s'; setTimeout(() => el.remove(), 500); }
            });
        }, 4000);
    </script>
</body>
</html>
