<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ClipNode — Share Code Like a Pro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        #editor-container { height: calc(100vh - 64px); } 
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #1e1e1e; }
        ::-webkit-scrollbar-thumb { background: #333333; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #4f4f4f; }
        .toast {
            transition: all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        }
    </style>
</head>
<body class="bg-[#1e1e1e] text-gray-200 overflow-hidden flex flex-col h-screen">

    <!-- Header Navigation -->
    <header class="h-16 bg-[#252526] border-b border-[#333333] flex items-center justify-between px-6 shadow-md z-10">
        
        <div class="flex items-center gap-6">
            <a href="/" class="text-xl font-bold tracking-tight text-white flex items-center gap-2 hover:opacity-90 transition-opacity">
                <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center shadow-lg shadow-blue-500/20">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                    </svg>
                </div>
                <span>Clip<span class="text-blue-500">Node</span></span>
            </a>

            <!-- Toolbar Controls -->
            <div class="flex items-center gap-3">
                <!-- Language Selector -->
                <div class="flex items-center gap-2 bg-[#1e1e1e] border border-[#3c3c3c] rounded px-3 py-1.5 focus-within:border-blue-500 transition-colors">
                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    <select id="language-select" class="bg-transparent text-xs text-gray-200 focus:outline-none cursor-pointer">
                        <option value="javascript" class="bg-[#252526]">JavaScript</option>
                        <option value="typescript" class="bg-[#252526]">TypeScript</option>
                        <option value="python" class="bg-[#252526]">Python</option>
                        <option value="cpp" class="bg-[#252526]">C++</option>
                        <option value="java" class="bg-[#252526]">Java</option>
                        <option value="go" class="bg-[#252526]">Go</option>
                        <option value="rust" class="bg-[#252526]">Rust</option>
                        <option value="html" class="bg-[#252526]">HTML</option>
                        <option value="css" class="bg-[#252526]">CSS</option>
                        <option value="json" class="bg-[#252526]">JSON</option>
                        <option value="sql" class="bg-[#252526]">SQL</option>
                        <option value="markdown" class="bg-[#252526]">Markdown</option>
                        <option value="shell" class="bg-[#252526]">Shell / Bash</option>
                        <option value="yaml" class="bg-[#252526]">YAML</option>
                        <option value="plaintext" class="bg-[#252526]">Plain Text</option>
                    </select>
                </div>

                <!-- Expiry Selector -->
                <div class="flex items-center gap-2 bg-[#1e1e1e] border border-[#3c3c3c] rounded px-3 py-1.5 focus-within:border-blue-500 transition-colors">
                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <select id="expiry-select" class="bg-transparent text-xs text-gray-200 focus:outline-none cursor-pointer">
                        <option value="1h" class="bg-[#252526]">Expires in 1 Hour</option>
                        <option value="24h" class="bg-[#252526]" selected>Expires in 24 Hours</option>
                        <option value="7d" class="bg-[#252526]">Expires in 7 Days</option>
                        <option value="30d" class="bg-[#252526]">Expires in 30 Days</option>
                        <option value="never" class="bg-[#252526]">Never Expire</option>
                    </select>
                </div>

                <!-- Live Collaboration Toggle -->
                <label id="live-toggle-wrapper" title="Enable Real-Time Live Collaboration" class="flex items-center gap-2 bg-[#1e1e1e] border border-[#3c3c3c] rounded px-3 py-1.5 cursor-pointer hover:border-blue-500 transition-colors">
                    <input type="checkbox" id="live-collaboration-toggle" class="w-3.5 h-3.5 text-blue-600 bg-[#252526] border-[#3c3c3c] rounded focus:ring-blue-500 focus:ring-1 cursor-pointer">
                    <div class="flex items-center gap-1.5 text-xs text-gray-200 font-medium select-none">
                        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                        <span>Live Collaboration</span>
                    </div>
                </label>

                <!-- Theme Selector -->
                <div class="flex items-center gap-2 bg-[#1e1e1e] border border-[#3c3c3c] rounded px-3 py-1.5 focus-within:border-blue-500 transition-colors">
                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path></svg>
                    <select id="theme-select" class="bg-transparent text-xs text-gray-200 focus:outline-none cursor-pointer">
                        <option value="vs-dark" class="bg-[#252526]">Dark Theme</option>
                        <option value="vs" class="bg-[#252526]">Light Theme</option>
                        <option value="hc-black" class="bg-[#252526]">High Contrast</option>
                    </select>
                </div>

                <!-- Word Wrap Toggle -->
                <button id="wrap-btn" title="Toggle Word Wrap" class="bg-[#1e1e1e] hover:bg-[#333333] border border-[#3c3c3c] text-xs text-gray-300 rounded px-3 py-1.5 transition-colors flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h10a4 4 0 010 8h-1m-4-4l-4 4 4 4"></path></svg>
                    <span>Wrap</span>
                </button>
            </div>
        </div>

        <div class="flex items-center gap-3">
            <span class="text-xs text-gray-400 font-mono hidden md:inline-block">Press <kbd class="bg-[#1e1e1e] border border-[#3c3c3c] px-1.5 py-0.5 rounded text-gray-300">Ctrl+S</kbd> to save</span>
            <button id="save-btn" class="bg-blue-600 hover:bg-blue-500 active:scale-95 transition-all text-white text-sm font-semibold px-5 py-2 rounded-lg shadow-lg shadow-blue-600/30 flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path></svg>
                <span>Create Paste</span>
            </button>
        </div>

    </header>

    <div id="editor-container" class="w-full flex-1"></div>

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2"></div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.39.0/min/vs/loader.min.js"></script>
    <script>
        let isWordWrap = false;

        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            const bgClass = type === 'error' ? 'bg-red-600' : type === 'success' ? 'bg-emerald-600' : 'bg-blue-600';
            
            toast.className = `toast ${bgClass} text-white px-4 py-2.5 rounded-lg shadow-xl text-sm font-medium flex items-center gap-2 transform translate-y-2 opacity-0`;
            toast.innerHTML = `
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <span>${message}</span>
            `;
            container.appendChild(toast);

            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            });

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        require.config({ paths: { 'vs': 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.39.0/min/vs' }});

        require(['vs/editor/editor.main'], function() {
            window.editor = monaco.editor.create(document.getElementById('editor-container'), {
                value: '// Paste your code or text here...\n',
                language: 'javascript',
                theme: 'vs-dark',
                automaticLayout: true,
                minimap: { enabled: false },
                fontSize: 14,
                fontFamily: "'Fira Code', 'JetBrains Mono', 'Courier New', monospace",
                padding: { top: 16 },
                wordWrap: 'off',
                renderLineHighlight: 'all'
            });

            // Language Selector
            document.getElementById('language-select').addEventListener('change', (e) => {
                monaco.editor.setModelLanguage(window.editor.getModel(), e.target.value);
            });

            // Theme Selector
            document.getElementById('theme-select').addEventListener('change', (e) => {
                monaco.editor.setTheme(e.target.value);
            });

            // Word Wrap Toggle
            document.getElementById('wrap-btn').addEventListener('click', () => {
                isWordWrap = !isWordWrap;
                window.editor.updateOptions({ wordWrap: isWordWrap ? 'on' : 'off' });
                document.getElementById('wrap-btn').classList.toggle('border-blue-500', isWordWrap);
                showToast(`Word wrap ${isWordWrap ? 'enabled' : 'disabled'}`);
            });

            // Ctrl+S / Cmd+S Shortcut
            window.editor.addCommand(monaco.KeyMod.CtrlCmd | monaco.KeyCode.KeyS, () => {
                savePaste();
            });
        });

        async function savePaste() {
            const content = window.editor.getValue();
            const language = document.getElementById('language-select').value;
            const expiry = document.getElementById('expiry-select').value;
            const isLive = document.getElementById('live-collaboration-toggle').checked;

            if (!content || content.trim() === '' || content.trim() === '// Paste your code or text here...') {
                showToast("Please enter some code before saving!", "error");
                return;
            }

            const saveBtn = document.getElementById('save-btn');
            saveBtn.disabled = true;
            saveBtn.classList.add('opacity-70', 'cursor-not-allowed');

            try {
                const response = await fetch('/api/paste', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ content, language, expiry, isLive })
                });

                const data = await response.json();
                
                if (response.ok) {
                    showToast("Paste created! Redirecting...", "success");
                    setTimeout(() => {
                        window.location.href = `/${data.shortId}`;
                    }, 500);
                } else {
                    showToast(data.error || 'Failed to create paste', 'error');
                }
            } catch (error) {
                console.error(error);
                showToast('Failed to connect to server', 'error');
            } finally {
                saveBtn.disabled = false;
                saveBtn.classList.remove('opacity-70', 'cursor-not-allowed');
            }
        }

        document.getElementById('save-btn').addEventListener('click', savePaste);
    </script>
</body>
</html>