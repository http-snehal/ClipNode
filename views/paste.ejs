<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ClipNode — View Snippet (<%= paste.shortId %>)</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        #editor-container { height: calc(100vh - 64px); }
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #1e1e1e; }
        ::-webkit-scrollbar-thumb { background: #333333; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #4f4f4f; }
        .toast {
            transition: all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        }
    </style>
</head>
<body class="bg-[#1e1e1e] text-gray-200 overflow-hidden flex flex-col h-screen">

    <!-- Navigation Bar -->
    <header class="h-16 bg-[#252526] border-b border-[#333333] flex items-center justify-between px-6 shadow-md z-10">
        
        <div class="flex items-center gap-4 md:gap-6">
            <a href="/" class="text-xl font-bold tracking-tight text-white flex items-center gap-2 hover:opacity-90 transition-opacity">
                <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center shadow-lg shadow-blue-500/20">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                    </svg>
                </div>
                <span>Clip<span class="text-blue-500">Node</span></span>
            </a>
            
            <span class="bg-[#1e1e1e] border border-[#3c3c3c] text-xs text-blue-400 font-mono rounded px-2.5 py-1 uppercase tracking-wider font-semibold">
                <%= paste.language || 'plaintext' %>
            </span>

            <div class="hidden sm:flex items-center gap-2 text-xs text-gray-400 font-mono bg-[#1e1e1e] px-3 py-1.5 rounded border border-[#3c3c3c]">
                <svg class="w-3.5 h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <% if (paste.expiresAt) { %>
                    <span>Expires: <%= new Date(paste.expiresAt).toLocaleString() %></span>
                <% } else { %>
                    <span class="text-emerald-400 font-semibold">Never Expires</span>
                <% } %>
            </div>
        </div>

        <!-- Toolbar Actions -->
        <div class="flex items-center gap-2 md:gap-3">

            <% if (currentUser) { %>
                <span class="text-xs text-gray-400 hidden sm:inline-block">Hi, <span class="text-gray-200 font-medium"><%= currentUser.username %></span></span>
                <form action="/logout" method="POST" style="display:inline">
                    <button type="submit" class="bg-[#1e1e1e] hover:bg-[#333] border border-[#3c3c3c] text-xs text-gray-300 px-3 py-1.5 rounded-lg transition-colors">Logout</button>
                </form>
            <% } else { %>
                <a href="/login" class="hidden sm:inline-block bg-[#1e1e1e] hover:bg-[#333] border border-[#3c3c3c] text-xs text-gray-300 px-3 py-1.5 rounded-lg transition-colors">Log In</a>
                <a href="/signup" class="hidden sm:inline-block bg-blue-600 hover:bg-blue-500 text-xs text-white font-semibold px-3 py-1.5 rounded-lg transition-colors">Sign Up</a>
            <% } %>

            <!-- Theme Selector -->
            <select id="theme-select" class="bg-[#1e1e1e] border border-[#3c3c3c] text-xs text-gray-200 rounded px-2.5 py-1.5 focus:outline-none cursor-pointer">
                <option value="vs-dark" class="bg-[#252526]">Dark Theme</option>
                <option value="vs" class="bg-[#252526]">Light Theme</option>
                <option value="hc-black" class="bg-[#252526]">High Contrast</option>
            </select>

            <!-- Word Wrap Button -->
            <button id="wrap-btn" title="Toggle Word Wrap" class="bg-[#1e1e1e] hover:bg-[#333333] border border-[#3c3c3c] text-xs text-gray-300 rounded px-2.5 py-1.5 transition-colors flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h10a4 4 0 010 8h-1m-4-4l-4 4 4 4"></path></svg>
                <span class="hidden sm:inline">Wrap</span>
            </button>

            <!-- Copy Code Button -->
            <button id="copy-code-btn" class="bg-[#333333] hover:bg-[#444444] transition-colors text-white text-xs font-medium px-3 py-1.5 rounded border border-[#444444] flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                <span>Copy Code</span>
            </button>

            <!-- Copy Link Button -->
            <button id="copy-link-btn" class="bg-[#333333] hover:bg-[#444444] transition-colors text-white text-xs font-medium px-3 py-1.5 rounded border border-[#444444] flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
                <span class="hidden sm:inline">Copy Link</span>
            </button>

            <!-- Raw Button -->
            <a href="/raw/<%= paste.shortId %>" target="_blank" class="bg-[#333333] hover:bg-[#444444] transition-colors text-white text-xs font-medium px-3 py-1.5 rounded border border-[#444444] flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
                <span>Raw</span>
            </a>

            <!-- Download Button -->
            <button id="download-btn" class="bg-[#333333] hover:bg-[#444444] transition-colors text-white text-xs font-medium px-3 py-1.5 rounded border border-[#444444] flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                <span class="hidden sm:inline">Download</span>
            </button>

            <!-- New Paste Button -->
            <a href="/" class="bg-blue-600 hover:bg-blue-500 transition-colors text-white text-xs font-semibold px-4 py-1.5 rounded-lg shadow-md shadow-blue-600/30 flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                <span>New</span>
            </a>
        </div>

    </header>

    <textarea id="raw-content" style="display:none;"><%= paste.content %></textarea>

    <div id="editor-container" class="w-full flex-1"></div>

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2"></div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.39.0/min/vs/loader.min.js"></script>
    <script>
        let isWordWrap = false;
        const pasteLanguage = '<%= paste.language || "plaintext" %>';
        const pasteId = '<%= paste.shortId %>';

        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            const bgClass = type === 'error' ? 'bg-red-600' : type === 'success' ? 'bg-emerald-600' : 'bg-blue-600';
            
            toast.className = `toast ${bgClass} text-white px-4 py-2.5 rounded-lg shadow-xl text-sm font-medium flex items-center gap-2 transform translate-y-2 opacity-0`;
            toast.innerHTML = `
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <span>${message}</span>
            `;
            container.appendChild(toast);

            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            });

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        require.config({ paths: { 'vs': 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.39.0/min/vs' }});

        require(['vs/editor/editor.main'], function() {
            const rawText = document.getElementById('raw-content').value;

            window.editor = monaco.editor.create(document.getElementById('editor-container'), {
                value: rawText,
                language: pasteLanguage,
                theme: 'vs-dark',
                readOnly: true,
                automaticLayout: true,
                minimap: { enabled: false },
                fontSize: 14,
                fontFamily: "'Fira Code', 'JetBrains Mono', 'Courier New', monospace",
                padding: { top: 16 },
                wordWrap: 'off'
            });

            // Theme Selector
            document.getElementById('theme-select').addEventListener('change', (e) => {
                monaco.editor.setTheme(e.target.value);
            });

            // Word Wrap Toggle
            document.getElementById('wrap-btn').addEventListener('click', () => {
                isWordWrap = !isWordWrap;
                window.editor.updateOptions({ wordWrap: isWordWrap ? 'on' : 'off' });
                document.getElementById('wrap-btn').classList.toggle('border-blue-500', isWordWrap);
                showToast(`Word wrap ${isWordWrap ? 'enabled' : 'disabled'}`);
            });
        });

        // Copy Code Button
        document.getElementById('copy-code-btn').addEventListener('click', () => {
            const text = document.getElementById('raw-content').value;
            navigator.clipboard.writeText(text).then(() => {
                showToast("Code copied to clipboard!", "success");
            }).catch(err => {
                showToast("Failed to copy code", "error");
            });
        });

        // Copy Link Button
        document.getElementById('copy-link-btn').addEventListener('click', () => {
            navigator.clipboard.writeText(window.location.href).then(() => {
                showToast("Share link copied to clipboard!", "success");
            }).catch(err => {
                showToast("Failed to copy link", "error");
            });
        });

        // Download Button
        document.getElementById('download-btn').addEventListener('click', () => {
            const text = document.getElementById('raw-content').value;
            const extMap = {
                javascript: 'js',
                typescript: 'ts',
                python: 'py',
                cpp: 'cpp',
                java: 'java',
                go: 'go',
                rust: 'rs',
                html: 'html',
                css: 'css',
                json: 'json',
                sql: 'sql',
                markdown: 'md',
                shell: 'sh',
                yaml: 'yml'
            };
            const ext = extMap[pasteLanguage] || 'txt';
            const filename = `clipnode-${pasteId}.${ext}`;

            const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);

            showToast(`Downloading ${filename}...`, "info");
        });
    </script>
</body>
</html>